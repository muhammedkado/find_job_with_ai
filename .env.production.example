APP_NAME="Find Job with AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://findjob.mkado.dev

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite — this app has no
# real persistence needs, sqlite just satisfies Laravel's stock scaffolding.

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Optional — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Leave blank and job search always returns the bundled sample results.
RAPIDAPI_KEY=

# Shared daily quota across every visitor (not per-IP — see the "ai"
# rate limiter in app/Providers/RouteServiceProvider.php for that).
DEMO_GEMINI_DAILY_BUDGET=150
DEMO_JSEARCH_DAILY_BUDGET=10
